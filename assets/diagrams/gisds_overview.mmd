flowchart TB
    TITLE["GISDS — GIS and Remote Sensing Database Sources"]
    subgraph EXAMPLES["Selected examples from the existing catalogue<br/>Illustrative resources, not new classes or domain assignments"]
        SATELLITE["Copernicus Browser<br/>USGS EarthExplorer"]
        LANDCOVER["ESA WorldCover<br/>Dynamic World"]
        WATER["Global Surface Water<br/>GloFAS / Global Flood Monitoring"]
        AIRBORNE["ICGC viewers and downloads<br/>CNIG / IGN Download Centre"]
        COMPUTATION["Google Earth Engine<br/>Geospatial computation"]
        MAPS["Instamaps<br/>Map presentation"]
    end
    DRM["DRM (output) Database Reference Methodology<br/>Shared identities · Classifications and mappings · Relationships · Provenance"]
    subgraph APPLICATIONS["Analysis, Intelligence and Applications<br/>Emerging uses — not an operational analytical platform"]
        INTELLIGENCE["EII Indicator<br/>Inventory"]
        DECISION["Decision-support<br/>systems"]
        PLACE["Place-based<br/>interpretation"]
        TECHNOLOGY["Technology and<br/>design choice"]
    end
    TITLE --> EXAMPLES
    EXAMPLES <--> DRM
    DRM <--> APPLICATIONS
    classDef heading fill:#cce3f9,stroke:#173b6b,color:#15243d;
    classDef knowledge fill:#e1f0e6,stroke:#41744d,color:#203d29;
    classDef method fill:#e1daf0,stroke:#574087,color:#29223e;
    classDef sources fill:#feeec9,stroke:#a16a16,color:#543a13;
    classDef card fill:#fef6e3,stroke:#a16a16,color:#302b20;
    classDef output fill:#eaedf1,stroke:#7c8c9d,color:#25334a;
    classDef neutral fill:#f8f9fa,stroke:#99a4b0,color:#3a4656;
    class TITLE heading;
    class EXAMPLES sources;
    class SATELLITE,LANDCOVER,WATER,AIRBORNE,COMPUTATION,MAPS card;
    class DRM federation;
    class APPLICATIONS application;
    class INTELLIGENCE,DECISION,PLACE,TECHNOLOGY applicationcard;
    class DRM developing;
    classDef federation fill:#e1daf0,stroke:#574087,stroke-width:2,color:#29223e,font-weight:600,font-size:23.8;
    classDef application fill:#eaedf1,stroke:#7c8c9d,stroke-width:2,color:#25334a,font-weight:600,font-size:22.95;
